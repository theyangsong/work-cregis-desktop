## 8. 变量白名单与自动化校验（强制）

### 8.1 政策

> 业务代码中的 `var(--*)` **只允许**来自 `@eds/desktop-tokens/json` 白名单，以及 **`token-allowlist.business.json` 中已批准的业务例外**。  
> 使用设计系统外变量 → **CI / pre-commit 必须失败**。

### 8.2 报错文案（固定）

```
变量 --xxx 在 @eds/desktop-tokens 中不存在。
请：(1) 改用 spec 中已有语义 token；或 (2) 向 EDS 维护者申请新增 token；或 (3) 获批后使用硬编码（须注明原因）。
禁止：私造 --xxx 或从 Showcase/Website 复制变量名。
参见：eds-desktop/.cursor/rules/eds-project.mdc §1
```

Agent / Code Review 可简化为：

> **「变量在设计系统里不存在，是否使用硬编码？」** — 默认答案为 **否**；须走维护者确认或改合法 token。

### 8.3 推荐脚本 `scripts/lint-ds-tokens.mjs`

```javascript
#!/usr/bin/env node
/**
 * 扫描 src 下 CSS/Vue 中 var(--*)，对照 @eds/desktop-tokens/json 白名单。
 * 用法：node scripts/lint-ds-tokens.mjs
 * 前置：eds-desktop 已 build（存在 packages/tokens/dist/json/tokens.json）
 */
import { readFileSync, readdirSync, statSync } from 'node:fs';
import { join, extname } from 'node:path';
import { createRequire } from 'node:module';

const require = createRequire(import.meta.url);
const tokens = require('@eds/desktop-tokens/json');

/** 从 tokens.json flatten 所有 --* 变量名 */
function flattenTokenNames(payload) {
  const names = new Set();
  function walk(obj) {
    if (!obj || typeof obj !== 'object') return;
    for (const [key, val] of Object.entries(obj)) {
      if (key.startsWith('--')) names.add(key);
      if (typeof val === 'string' && val.startsWith('var(--')) {
        const m = val.match(/var\(\s*(--[a-zA-Z0-9_-]+)/);
        if (m) names.add(m[1]);
      }
      walk(val);
    }
  }
  walk(payload);
  // scale / typography 扁平键
  for (const section of ['scaleSemantic', 'typographySemantic', 'typography', 'scale']) {
    if (payload[section]) {
      for (const k of Object.keys(payload[section])) {
        if (k.startsWith('--')) names.add(k);
      }
    }
  }
  return names;
}

/** 业务批准例外 — 每条须 PR 说明 + 维护者 approve */
function loadBusinessAllowlist() {
  try {
    const raw = readFileSync('token-allowlist.business.json', 'utf8');
    return new Set(JSON.parse(raw).allow ?? []);
  } catch {
    return new Set([
      // 示例：'--app-preview-width', '--app-preview-height',
    ]);
  }
}

const ALLOWED = flattenTokenNames(tokens);
const BUSINESS = loadBusinessAllowlist();
const VAR_RE = /var\(\s*(--[a-zA-Z0-9_-]+)/g;
const DEFINE_RE = /^\s*(--[a-zA-Z0-9_-]+)\s*:/gm;

const SRC = join(process.cwd(), 'src');
const EXT = new Set(['.css', '.vue']);
let failed = false;

function scanFile(file) {
  const content = readFileSync(file, 'utf8');
  for (const m of content.matchAll(VAR_RE)) {
    const name = m[1];
    if (!ALLOWED.has(name) && !BUSINESS.has(name)) {
      console.error(`[lint-ds-tokens] ${file}\n  变量 ${name} 在设计系统里不存在，是否使用硬编码？\n  请改用 spec 已有 token 或向 EDS 维护者确认。\n`);
      failed = true;
    }
  }
  for (const m of content.matchAll(DEFINE_RE)) {
    const name = m[1];
    if (!ALLOWED.has(name) && !BUSINESS.has(name)) {
      console.error(`[lint-ds-tokens] ${file}\n  禁止私定义 CSS 变量 ${name}（eds-project §1.2）。\n`);
      failed = true;
    }
  }
}

function walk(dir) {
  for (const ent of readdirSync(dir)) {
    const p = join(dir, ent);
    if (statSync(p).isDirectory()) walk(p);
    else if (EXT.has(extname(p))) scanFile(p);
  }
}

walk(SRC);

if (failed) process.exit(1);
console.log('✓ lint-ds-tokens passed');
```

### 8.4 `package.json` 接入

```json
{
  "scripts": {
    "lint:ds-tokens": "node scripts/lint-ds-tokens.mjs",
    "lint": "pnpm lint:ds-tokens && …"
  }
}
```

